@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/@PROJECT_NAME@Targets.cmake")

set(SWMM_FOUND 1)

set_and_check(SWMM_INCLUDE_DIR "@PACKAGE_INCLUDE_INSTALL_DIR@")
set_and_check(SWMM_INCLUDE_DIRS ${SWMM_INCLUDE_DIR})

set_and_check(SWMM_LIBRARY_DIR "@PACKAGE_LIB_INSTALL_DIR@")

set_and_check(SWMM_LIBRARIES "@PACKAGE_LIB_INSTALL_DIR@")
set_and_check(SWMM_SYSCONFIG_DIR "@PACKAGE_SYSCONFIG_INSTALL_DIR@")

check_required_components("@PROJECT_NAME@")
